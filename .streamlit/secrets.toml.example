# Copie este arquivo para .streamlit/secrets.toml (local) OU cole o mesmo
# conteúdo em "Settings > Secrets" no Streamlit Community Cloud.
#
# NUNCA faça commit do arquivo secrets.toml de verdade no Git —
# ele já está listado no .gitignore deste projeto.

# Opção A - LOCAL (Windows, com o driver ODBC da Microsoft instalado):
# [sqlserver]
# servidor   = "seu-servidor-ou-ip"
# porta      = 1433
# database   = "PROTHEUS_PRODUCAO"
# usuario    = "usuario_leitura"
# senha      = "sua_senha_aqui"
# driver     = "ODBC Driver 18 for SQL Server"
# odbc_extra = "TrustServerCertificate=yes;Encrypt=yes"

# Opção B - STREAMLIT COMMUNITY CLOUD (sem ODBC nenhum - ver README.md,
# secao 2, sobre o conflito de pacote que o FreeTDS/unixODBC via apt dava):
[sqlserver]
servidor = "seu-servidor-ou-ip"
porta    = 1433
database = "PROTHEUS_PRODUCAO"
usuario  = "usuario_leitura"
senha    = "sua_senha_aqui"
driver   = "pymssql"
