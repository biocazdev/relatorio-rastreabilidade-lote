# Copie este arquivo para ".env" (mesma pasta do app.py) e preencha com os
# dados do ambiente que você quer testar (ex: homologação).
#
# NUNCA faça commit do arquivo .env de verdade no Git — ele já está
# listado no .gitignore deste projeto.
#
# Uso local rápido (sem mexer em .streamlit/secrets.toml):
#   1. copie este arquivo para .env
#   2. preencha os valores abaixo
#   3. streamlit run app.py

SQLSERVER_SERVIDOR=seu-servidor-ou-ip
SQLSERVER_PORTA=1433
SQLSERVER_DATABASE=nome_da_base
SQLSERVER_USUARIO=usuario_leitura
SQLSERVER_SENHA=sua_senha_aqui
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ODBC_EXTRA=TrustServerCertificate=yes;Encrypt=yes




